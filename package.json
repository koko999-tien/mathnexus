{
  "name": "mathnexus-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/icons.mjs && node scripts/sitemap.mjs",
    "prebuild": "node scripts/icons.mjs && node scripts/sitemap.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "build:pages": "node scripts/icons.mjs && node scripts/sitemap.mjs && tsc -b && node scripts/pages.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "knowledge:check": "node scripts/knowledge-audit.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "perf:audit": "npm run build && node scripts/perf-audit.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "decimal.js": "^10.6.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
